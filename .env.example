# Two native Postgres URLs (postgresql://..., never with jdbc:). Each environment
# is its own database; the schema (sebas) is fixed in the migrations, so no
# search_path is needed. See migrations/README.md.
#
# DATABASE_URL — used by sqlx-cli and psql. MAY embed credentials (user[:pw]@host).
DATABASE_URL=postgresql://noetrevino@localhost:5432/sebastian-website
# APP_DATABASE_URL — used by the Spring app, which prepends jdbc:. Must NOT embed
# credentials: the JDBC driver treats user@host as a hostname. Creds go in
# DATABASE_USER/DATABASE_PW below.
APP_DATABASE_URL=postgresql://localhost:5432/sebastian-website
DATABASE_USER=noetrevino
DATABASE_PW=your_password_here
DEFAULT_SCHEMA=sebas

BACKEND_PORT=8081

EMAIL_USER=noreply.sebastianhavner@gmail.com
EMAIL_PW=your_app_password_here
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_here

# Stripe (prod: live keys; qa/dev: sk_test_/whsec_ from the sandbox)
STRIPE_SECRET=sk_live_...
# Signing secret of this environment's webhook endpoint (Dashboard -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Fulfillment: where the sheet music PDFs live (outside the repo checkout!)
PIECE_FILES_DIR=/var/lib/sebastian/files
# Optional: days a download link stays valid (default 30)
# DOWNLOAD_TOKEN_TTL_DAYS=30

VITE_BACKEND_URL=http://localhost:8081

# Observability - OpenTelemetry
# Local (Tempo on same server): http://localhost:4317
# Remote (Tempo on different node): https://otel.thenoetrevino.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
